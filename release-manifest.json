{
  "manifest_version": 1,
  "contracts": {
    "web_api": 1,
    "worker_protocol": 1,
    "database_schema": 1
  },
  "selective_rollout": {
    "web_ui": {
      "enabled": true,
      "contract_version": 1,
      "allowed_path_prefixes": [
        "app/static/",
        "images/"
      ],
      "validation_path_prefixes": [
        "tests/"
      ]
    },
    "controller": {
      "enabled": true,
      "contract_version": 1,
      "allowed_paths": [
        "app/controller_worker.py"
      ],
      "validation_path_prefixes": [
        "tests/"
      ]
    },
    "restore_worker": {
      "enabled": true,
      "contract_version": 1,
      "allowed_paths": [
        "app/restore_execution.py"
      ],
      "validation_path_prefixes": [
        "tests/"
      ]
    },
    "discovery_worker": {
      "enabled": true,
      "contract_version": 1,
      "allowed_paths": [
        "app/discovery_execution.py"
      ],
      "validation_path_prefixes": [
        "tests/"
      ]
    },
    "audit_worker": {
      "enabled": true,
      "contract_version": 1,
      "allowed_paths": [
        "app/audit_execution.py"
      ],
      "validation_path_prefixes": [
        "tests/"
      ]
    },
    "transfer_worker": {
      "enabled": true,
      "contract_version": 1,
      "allowed_paths": [
        "app/transfer_execution.py"
      ],
      "validation_path_prefixes": [
        "tests/"
      ]
    }
  }
}

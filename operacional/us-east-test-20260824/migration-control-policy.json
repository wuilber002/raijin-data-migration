{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LocateUsEastValidationControlBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::s3-raijin-us-east-control-056033527878-20260824"
    },
    {
      "Sid": "ManageUsEastValidationControlArtifacts",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::s3-raijin-us-east-control-056033527878-20260824/raijin/*"
    }
  ]
}

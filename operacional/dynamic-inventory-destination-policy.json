{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3InventoryDelivery",
      "Effect": "Allow",
      "Principal": {"Service": "s3.amazonaws.com"},
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::s3-raijin-dynamic-archive-20260820/raijin-inventory/*",
      "Condition": {
        "ArnLike": {"aws:SourceArn": "arn:aws:s3:::s3-raijin-dynamic-archive-20260820"},
        "StringEquals": {
          "aws:SourceAccount": "056033527878",
          "s3:x-amz-acl": "bucket-owner-full-control"
        }
      }
    }
  ]
}

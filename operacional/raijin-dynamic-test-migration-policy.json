{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DiscoverDynamicArchiveTestPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::s3-raijin-dynamic-archive-20260820",
      "Condition": {"StringLike": {"s3:prefix": ["linux-2.6.12-rc2/", "linux-2.6.12-rc2/*"]}}
    },
    {
      "Sid": "ReadDynamicArchiveTestPrefix",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectTagging", "s3:GetObjectVersionTagging"],
      "Resource": "arn:aws:s3:::s3-raijin-dynamic-archive-20260820/linux-2.6.12-rc2/*"
    }
  ]
}
